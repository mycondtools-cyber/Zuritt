# Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Пароль входу в /admin
ADMIN_PASSWORD="change-me"
# Будь-який довгий випадковий рядок для підпису сесії
AUTH_SECRET="replace-with-32+-random-chars"

# Лише для docker-compose (власний сервер): пароль бази в контейнері
POSTGRES_PASSWORD="replace-with-random"
# Порт на сервері, куди nginx проксіює airflow.mycond.eu
APP_PORT=3000
